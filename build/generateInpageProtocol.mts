import * as path from 'node:path'
import { mkdir, writeFile } from 'node:fs/promises'
import { fileURLToPath } from 'node:url'
import { SAFE_APPS_REQUEST_METHOD } from '../app/ts/types/safeRpcMethods.js'

// Copy protocol data at build time; privileged source and its dependency graph never enter the inpage compiler root.
const generatedDirectory = fileURLToPath(new URL('../app/inpage/ts/generated/', import.meta.url))
await mkdir(generatedDirectory, { recursive: true })
if (!/^[a-zA-Z0-9_]+$/.test(SAFE_APPS_REQUEST_METHOD)) throw new Error('Safe Apps method must be an RPC identifier')
await writeFile(path.join(generatedDirectory, 'safeRpcMethods.ts'), `// Generated by build/generateInpageProtocol.mts; do not edit.\nexport const SAFE_APPS_REQUEST_METHOD = '${ SAFE_APPS_REQUEST_METHOD }'\n`)
