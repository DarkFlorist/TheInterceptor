{
	"compilerOptions": {
		"target": "ES2021",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"rootDir": "app/shared/ts",
		"outDir": "app/shared/js",
		"declaration": true,
		"composite": true,
		"tsBuildInfoFile": "app/shared/js/tsconfig-shared.tsbuildinfo",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noPropertyAccessFromIndexSignature": true,
		"types": [],
		"lib": ["ES2021", "DOM"]
	},
	"include": ["app/shared/ts/**/*.ts"]
}
