{
	// use jsonc to allow comments
	"$schema": "https://unpkg.com/knip@6/schema-jsonc.json",

	"workspaces": {
		".": {
			"entry": [
				"app/ts/addressBookRender.ts",
				"app/ts/background/background-startup.ts",
				"app/ts/backgroundServiceWorker.ts",
				"app/ts/changeChain.ts",
				"app/ts/confirmTransaction.ts",
				"app/ts/fetchSimulationStack.ts",
				"app/ts/interceptorAccess.ts",
				"app/ts/popup.ts",
				"app/ts/settingsView.ts",
				"app/ts/websiteAccess.ts",
				"app/inpage/ts/document_start.ts",
				"app/inpage/ts/inpage.ts",
				"app/inpage/ts/listenContentScript.ts",
				"app/inpage/ts/listenContentScriptBootstrap.ts",
				"app/ts/simulationStack.ts",
				"test/tests/*.test.ts",
				"test/tests/*.ts"
			],
			"project": [
				"app/ts/**/*.{ts,tsx}",
				"app/inpage/ts/*.ts",
				"scripts/*.{ts,tsx,mts}",
				"test/**/*.{ts,tsx}"
			],
			"ignoreDependencies": [
				// browser globals and transformed vendor imports are not regular source imports
				"@types/firefox-webext-browser",
				"@noble/curves",

				// compileSolidityContracts.mts belongs to the isolated build workspace but resolves this root dependency
				"solc"
			]
		},

		// isolate ./build as workspace with it's own package.json
		"build": {
			"entry": [
				"cleanOutput.mts",
				"compileSolidityContracts.mts"
			],
			"project": ["**/*.{ts,tsx,mts}"]
		}
	},

	"treatConfigHintsAsErrors": true,

	// toggle for all applied rules
	"rules": {
		"dependencies": "error",
		"duplicates": "off",
		"enumMembers": "off",
		"exports": "error",
		"files": "error",
		"nsExports": "off",
		"nsTypes": "off",
		"types": "off",
		"unlisted": "error",
		"unresolved": "error"
	}
}
