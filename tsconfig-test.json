{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		// Tests run under Bun, so they need Bun's globals next to the WebExtension globals that tsconfig.json limits the app to.
		"types": ["bun", "firefox-webext-browser"],
		"rootDir": ".",
		"outDir": "test/js",
	},
	"include": [
		"./app/ts/**/*.ts",
		"./app/ts/**/*.tsx",
		"./test/**/*.ts",
	]
}
